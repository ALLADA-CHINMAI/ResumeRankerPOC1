# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────

# Azure OpenAI
OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
OPENAI_DEPLOYMENT_NAME=gpt-4o
OPENAI_API_KEY=your-api-key-here
EMBEDDINGS_OPENAI_DEPLOYMENT_NAME=text-embedding-ada-002
OPENAI_API_VERSION=2025-01-01-preview

# Azure AD (only needed if your deployment uses token-based auth)
AUTH_TENANT_ID=your-tenant-id
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret
AUTH_SCOPE=api://your-scope/.default

# Azure Cognitive Search
AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key

# Resume index — auto-created by the app on first run
AZURE_SEARCH_RESUME_INDEX_NAME=resume_chunks

# JD index — auto-created by the app on first run
AZURE_SEARCH_JD_INDEX_NAME=jd_chunks

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey==;EndpointSuffix=core.windows.net
RESUME_CONTAINER_NAME=resumes
JD_CONTAINER_NAME=jds

# SQL Database — stores JD metadata (req_id, jd_name, jd_blob, created_at, updated_at)
# Azure SQL / SQL Server (requires ODBC Driver 18 installed on the machine):
DB_CONNECTION_STRING=mssql+pyodbc://username:password@your-server.database.windows.net/your-database?driver=ODBC+Driver+18+for+SQL+Server
# SQLite (local dev, no extra driver needed):
# DB_CONNECTION_STRING=sqlite:///./resume_ranker.db
